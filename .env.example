# ─── Database ────────────────────────────────────────────────────────────────
# Both osTicket and the FastAPI integration tables live in the same MySQL/MariaDB
# database. This is the async URL for the Python side.
DATABASE_URL=mysql+aiomysql://osticket:changeme@localhost:3306/osticket

# ─── Docker Compose (compose-only vars, not read by the Python app) ───────────
MYSQL_ROOT_PASSWORD=changeme-root
MYSQL_PASSWORD=changeme

# ─── osTicket integration bridge ─────────────────────────────────────────────
# Shared secret between FastAPI and the PHP bridge plugin.
# Generate with: openssl rand -hex 32
# Must match the value configured in the osTicket plugin settings.
FASTAPI_INTEGRATION_KEY=replace-with-32-byte-hex-secret

# URL where the PHP bridge auth endpoint is reachable from the FastAPI container.
OSTICKET_AUTH_URL=http://osticket/api/auth/integration
# Timeout in seconds for calls to the osTicket auth endpoint.
OSTICKET_AUTH_TIMEOUT=10.0

# ─── JWT ─────────────────────────────────────────────────────────────────────
# Required in production. Generate with: openssl rand -hex 48
# If unset, a random per-process secret is used (safe for single-instance dev,
# but tokens will be invalidated on every restart and cannot be shared across
# multiple FastAPI workers).
JWT_SECRET_KEY=replace-with-48-byte-hex-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60

# Set to "true" to make startup FAIL if JWT_SECRET_KEY is not explicitly set.
# Recommended for production. Default: false (allows random fallback for dev).
REQUIRE_JWT_SECRET=false

# ─── Security ────────────────────────────────────────────────────────────────
# Comma-separated list of allowed CORS origins. Empty string = no origins allowed.
CORS_ORIGINS=http://localhost:3000

# ─── osTicket Docker image (compose-only, used by docker/osticket/entrypoint.sh) ─
OSTICKET_ADMIN_EMAIL=admin@example.local
OSTICKET_ADMIN_FIRSTNAME=Admin
OSTICKET_ADMIN_LASTNAME=User
OSTICKET_ADMIN_PASSWORD=changeme-admin
OSTICKET_SITE_NAME=fast-ticket Dev

# "true" (default): the container installs osTicket headlessly on first boot and
# re-converges on every start (idempotent). "false": run the web wizard yourself.
OSTICKET_AUTO_SETUP=true

# Admin login username for the osTicket helpdesk UI and bridge auth.
# IMPORTANT: Must NOT be 'admin', 'admins', 'username', or 'osticket' —
# osTicket's installer explicitly rejects these as insecure usernames.
OSTICKET_ADMIN_USERNAME=helpdesk

# System/support inbox email address. Must DIFFER from OSTICKET_ADMIN_EMAIL.
# This becomes the default email inbox osTicket receives tickets at.
OSTICKET_SYSTEM_EMAIL=support@example.local

# ─── Operational ─────────────────────────────────────────────────────────────
# Outbox event polling interval in seconds.
EVENT_POLL_INTERVAL_SECONDS=1.0
# Events processed per polling cycle.
EVENT_BATCH_SIZE=100
# Maximum retry attempts before an event is dead-lettered.
# (the outbox is read by a per-process cursor; events are not retried)
# Days to keep processed/failed events before purging.
EVENT_RETENTION_DAYS=30

# The bridge plugin creates the integration tables itself (bridge/schema.php) when it is
# enabled. Set to "true" only for a local database with no plugin, to have the API create them.
AUTO_CREATE_SCHEMA=false

# Table prefix osTicket was installed with (TABLE_PREFIX in its ost-config.php). Default ost_.
OSTICKET_TABLE_PREFIX=ost_

# Timezone osTicket's DATETIME columns are written in (IANA name or +HH:MM). Empty = read it from osTicket's
# db_timezone setting / the database server. The API answers every timestamp as UTC with a Z; `make doctor` shows the source.
DB_TIMEZONE=

# ── Login protection, rate limits, request limits ───────────────────────────
# Failed logins per (username, client IP) before a lockout, and how long it lasts.
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCKOUT_SECONDS=300
# Default limit per client IP for every route (slowapi syntax), and where counters live
# (memory:// is per process; redis://host:6379 shares them between workers).
RATE_LIMIT_DEFAULT=300/minute
RATE_LIMIT_STORAGE_URI=memory://
# Reverse proxies in front of the API that append to X-Forwarded-For. Leave 0 unless you run one:
# with 0 the header is ignored, so clients cannot spoof their address to dodge limits.
TRUSTED_PROXY_COUNT=0
# Largest accepted request body, in bytes (413 above it).
MAX_REQUEST_BYTES=1000000

# ── WebSocket ────────────────────────────────────────────────────────────────
# How often open connections are re-validated (token expiry, disabled account, role changes), the number of
# sockets one agent may hold, and how long a client that cannot take a message is waited for before it is dropped.
ACCESS_CACHE_TTL_SECONDS=5
WS_RECHECK_SECONDS=15
WS_MAX_CONNECTIONS_PER_STAFF=10
WS_SEND_TIMEOUT_SECONDS=5

# ── Hardening ────────────────────────────────────────────────────────────────
# Serve /docs, /redoc and /openapi.json. Set false in production if the API's shape is not meant to be public.
API_DOCS_ENABLED=true
